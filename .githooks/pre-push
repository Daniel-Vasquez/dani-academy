#!/bin/sh
# Antes de cada `git push`: las mismas comprobaciones rápidas del trabajo `verify` del CI.
# Si alguna falla, el push se cancela y nada llega a main (ni a producción en Vercel).
# Los E2E no se ejecutan aquí (tardan): se lanzan a mano con `npm run test:e2e:local`
# y siempre en el CI de GitHub. Emergencia: `git push --no-verify` salta este hook.
set -e

echo "▶ pre-push: formato, lint, tipos y tests…"
npm run --silent format:check
npm run --silent lint
npm run --silent check
npm run --silent test:run
echo "✔ pre-push: todo correcto, subiendo."
