# ─────────────────────────────────────────────────────────────
# Dani Academy · Variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# `.env` NUNCA se sube a Git. En Vercel se configuran en
# Settings → Environment Variables (Production / Preview).
# ─────────────────────────────────────────────────────────────

# ─── Base de datos · Tanda 2 ─────────────────────────────────
# Atlas → Database → Connect → Drivers. Usuario con rol readWrite solo sobre MONGODB_DB.
MONGODB_URI="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=dani-academy"
# Nombre de la base de datos (usa uno distinto por entorno: dani_academy, dani_academy_preview…)
MONGODB_DB="dani_academy"

# ─── Autenticación (Better Auth) · Tanda 3 ───────────────────
# Mínimo 32 caracteres. Genera uno por entorno con: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL base de la app. Local: http://localhost:4321 · Producción: https://academy.<tu-dominio>
BETTER_AUTH_URL="http://localhost:4321"

# ─── Fechas y progreso · Tanda 5 ─────────────────────────────
# Zona horaria IANA para mostrar fechas y agrupar días de estudio
# (p. ej. Europe/Madrid, America/Bogota, America/Mexico_City)
APP_TIMEZONE="UTC"

# ─── Testing · Tanda 9 (opcional) ────────────────────────────
# Instancia alternativa para los tests E2E (replica set de un nodo en Docker)
# MONGODB_URI_TEST="mongodb://localhost:27017/?directConnection=true"

# ─── Observabilidad · futuro (temario A6, opcional) ──────────
# LOG_LEVEL="info"
# SENTRY_DSN=""
# PUBLIC_SENTRY_DSN=""
# SENTRY_AUTH_TOKEN=""
