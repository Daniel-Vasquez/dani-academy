---
type CalloutType = "note" | "tip" | "warning" | "exercise" | "mastery";
interface Props {
  type?: CalloutType;
  title?: string;
}
const { type = "note", title } = Astro.props;

const styles: Record<CalloutType, { label: string; border: string }> = {
  note: { label: "Nota", border: "border-info" },
  tip: { label: "Consejo", border: "border-accent" },
  warning: { label: "Cuidado", border: "border-warning" },
  exercise: { label: "Ejercicio", border: "border-accent" },
  mastery: { label: "Lo dominas si…", border: "border-accent-strong" },
};
const style = styles[type];
const heading = title ?? style.label;
---

<!--
  Hereda los estilos `prose` del artículo (listas, código, enlaces). Solo el título es `not-prose`:
  el plugin de tipografía ignora todo lo que esté dentro de un elemento `not-prose`, incluso
  si se vuelve a añadir `prose` dentro.
-->
<aside
  class:list={["my-8 rounded-r-xl border-l-4 bg-surface px-5 py-4", style.border]}
  aria-label={heading}
>
  <p class="not-prose mb-2 font-sans text-xs font-semibold tracking-wider text-muted uppercase">
    {heading}
  </p>
  <div class="[&>*]:my-2 [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
    <slot />
  </div>
</aside>
