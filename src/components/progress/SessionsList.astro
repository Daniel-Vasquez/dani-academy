---
import { formatDateTime, formatMinutes } from "@/lib/format";
import type { ProgressDashboard } from "@/server/services/stats.service";

interface Props {
  sessions: ProgressDashboard["sessions"];
}
const { sessions } = Astro.props;
---

{sessions.length === 0 ? (
  <p class="mt-4 text-sm text-muted">Tus sesiones aparecerán aquí cuando empieces a leer.</p>
) : (
  <ul class="mt-4 divide-y divide-surface-2 border-y border-surface-2">
    {sessions.map((s) => (
      <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3 text-sm">
        <span>{formatDateTime(s.startedAt)}</span>
        <span class="text-muted">
          <span class="font-medium text-fg tabular-nums">{formatMinutes(s.minutes)}</span>
          {" · "}
          {s.sections} {s.sections === 1 ? "sección" : "secciones"}
          {" · "}
          {s.courseIds.join(", ")}
        </span>
      </li>
    ))}
  </ul>
)}
