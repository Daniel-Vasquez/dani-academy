---
import Badge from "@/components/ui/Badge.astro";
import ProgressBar from "@/components/ui/ProgressBar.astro";
import { COURSE_STATUS } from "@/lib/status";
import type { ProgressDashboard } from "@/server/services/stats.service";

interface Props {
  byLevel: ProgressDashboard["byLevel"];
}
const { byLevel } = Astro.props;
---

<div class="mt-6 space-y-8">
  {byLevel.map((group) => (
    <div>
      <h3 class="text-sm font-semibold tracking-wider text-muted uppercase">{group.label}</h3>
      {group.items.length > 0 && (
        <ul class="mt-3 divide-y divide-surface-2 border-y border-surface-2">
          {group.items.map((item) => {
            const meta = COURSE_STATUS[item.status];
            return (
              <li class="grid grid-cols-[auto_1fr_auto] items-center gap-x-4 gap-y-2 py-4 sm:grid-cols-[3rem_minmax(0,1fr)_10rem_4rem_auto]">
                <span class="text-xs font-semibold text-muted">{item.course.id}</span>
                <a href={item.href!} class="min-w-0 truncate font-medium hover:text-accent-strong">
                  {item.course.data.title}
                </a>
                <div class="col-span-3 sm:col-span-1">
                  <ProgressBar
                    value={item.readCount}
                    max={item.totalSections}
                    label={`Progreso de ${item.course.data.title}`}
                  />
                </div>
                <span class="hidden text-right text-sm text-muted tabular-nums sm:block">
                  {item.readCount}/{item.totalSections}
                </span>
                <span class="col-start-3 row-start-1 sm:col-start-auto sm:row-start-auto">
                  <Badge tone={meta.tone}>{meta.label}</Badge>
                </span>
              </li>
            );
          })}
        </ul>
      )}
      {group.upcoming > 0 && (
        <p class="mt-3 text-sm text-muted">
          {group.items.length > 0 ? "Y " : ""}
          {group.upcoming} {group.upcoming === 1 ? "curso" : "cursos"} próximamente.
        </p>
      )}
    </div>
  ))}
</div>
