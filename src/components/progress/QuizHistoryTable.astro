---
import Badge from "@/components/ui/Badge.astro";
import { formatDateTime } from "@/lib/format";
import type { ProgressDashboard } from "@/server/services/stats.service";

interface Props {
  quizHistory: ProgressDashboard["quizHistory"];
}
const { quizHistory } = Astro.props;
---

{quizHistory.length === 0 ? (
  <p class="mt-4 text-sm text-muted">Todavía no has hecho ninguna evaluación.</p>
) : (
  <div class="mt-4 overflow-x-auto">
    <table class="w-full min-w-[32rem] text-left text-sm">
      <thead class="text-muted">
        <tr>
          <th scope="col" class="py-2 font-medium">
            Fecha
          </th>
          <th scope="col" class="py-2 font-medium">
            Curso
          </th>
          <th scope="col" class="py-2 font-medium">
            Nota
          </th>
          <th scope="col" class="py-2 font-medium">
            Resultado
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-surface-2">
        {quizHistory.map((a) => (
          <tr>
            <td class="py-3 whitespace-nowrap">{formatDateTime(a.submittedAt)}</td>
            <td class="py-3">
              <span class="mr-2 text-xs font-semibold text-muted">{a.courseId}</span>
              {a.courseHref ? (
                <a href={`${a.courseHref}/evaluacion`} class="hover:text-accent-strong">
                  {a.courseTitle}
                </a>
              ) : (
                a.courseTitle
              )}
            </td>
            <td class="py-3 tabular-nums">
              {a.score}/{a.total}
            </td>
            <td class="py-3">
              {a.passed ? (
                <Badge tone="accent">Aprobado</Badge>
              ) : (
                <Badge tone="warning">No aprobado</Badge>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
