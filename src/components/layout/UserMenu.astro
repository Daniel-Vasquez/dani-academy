---
const user = Astro.locals.user;
---

{user && (
  <div class="flex items-center gap-1">
    <span class="hidden px-2 text-sm text-muted md:inline">{user.name}</span>
    <button
      type="button"
      data-sign-out
      class="rounded-lg px-2 py-1.5 text-sm sm:px-3 text-muted transition-colors hover:bg-surface hover:text-fg disabled:opacity-60"
    >
      Salir
    </button>
  </div>
)}

<script>
  import { authClient } from "@/lib/auth-client";

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLButtonElement>("[data-sign-out]").forEach((btn) => {
      btn.onclick = async () => {
        btn.disabled = true;
        await authClient.signOut();
        window.location.assign("/login");
      };
    });
  });
</script>
