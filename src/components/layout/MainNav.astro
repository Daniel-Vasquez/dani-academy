---
const links = [
  { href: "/temario", label: "Temario" },
  { href: "/progreso", label: "Progreso" },
];
const path = Astro.url.pathname;
---

{Astro.locals.user && (
  <nav aria-label="Principal" class="flex items-center gap-1">
    {links.map((l) => (
      <a
        href={l.href}
        aria-current={path === l.href || path.startsWith(`${l.href}/`) ? "page" : undefined}
        class="rounded-lg px-2 py-1.5 text-sm sm:px-3 text-muted transition-colors hover:bg-surface hover:text-fg aria-[current=page]:font-medium aria-[current=page]:text-fg"
      >
        {l.label}
      </a>
    ))}
  </nav>
)}
