---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import CourseSidebar from "@/components/course/CourseSidebar.astro";
import SidebarToggle from "@/components/course/SidebarToggle";
import type { Course, Section } from "@/lib/content";

interface Props {
  title: string;
  description?: string;
  course: Course;
  sections: Section[];
  readIds: string[];
  currentSectionId?: string;
  current?: "overview" | "quiz";
  quizAvailable?: boolean;
}

const { title, description, ...sidebar } = Astro.props;
const { course, sections, readIds } = sidebar;
const readCount = sections.filter((s) => readIds.includes(s.data.sectionId)).length;
// Solo las páginas de sección pasan el panel de notas: la portada y la evaluación siguen a 2 columnas
const hasNotes = Astro.slots.has("notes");
---

<BaseLayout title={title} description={description}>
  <SiteHeader
    crumbs={[
      { label: "Temario", href: "/temario" },
      { label: `${course.id} · ${course.data.title}` },
    ]}
  >
    <slot name="header-actions" slot="actions" />
  </SiteHeader>

  <div
    class:list={[
      "mx-auto max-w-7xl transition-[grid-template-columns] duration-300 ease-in-out lg:grid lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-12 lg:px-6 lg:sidebar-closed:grid-cols-[0rem_minmax(0,1fr)]",
      hasNotes &&
        "xl:max-w-[96rem] xl:grid-cols-[15rem_minmax(0,1fr)_18rem] xl:gap-10 xl:sidebar-closed:grid-cols-[0rem_minmax(0,1fr)_18rem]",
    ]}
  >
    <!-- Índice en móvil: desplegable nativo, sin JavaScript -->
    <details class="border-b border-surface-2 px-4 py-3 lg:hidden">
      <summary class="flex cursor-pointer items-center justify-between text-sm font-medium">
        Índice del curso
        <span data-read-count class="text-muted tabular-nums">
          {readCount}/{sections.length}
        </span>
      </summary>
      <div class="pt-4 pb-2">
        <CourseSidebar {...sidebar} />
      </div>
    </details>

    <!-- Índice en escritorio: fijo al hacer scroll -->
    <aside class="hidden lg:block">
      <!-- Fuera de la capa que se recorta: cerrado, el botón sigue visible en el hueco entre columnas -->
      <div class="sticky top-16 z-10 flex h-0 justify-end">
        <SidebarToggle client:load />
      </div>
      <!-- invisible al cerrar: sus enlaces salen del orden de tabulación y del lector de pantalla -->
      <div
        id="temario"
        class="sticky top-18 max-h-[calc(100dvh-3.5rem)] overflow-x-hidden overflow-y-auto py-8 transition-[visibility] duration-300 [scrollbar-width:thin] sidebar-closed:invisible"
      >
        <!-- Ancho fijo: el texto se recorta mientras la columna se encoge, no se recoloca -->
        <div class:list={["w-72 pr-2", hasNotes && "xl:w-60"]}>
          <CourseSidebar {...sidebar} />
        </div>
      </div>
    </aside>

    <main
      id="contenido"
      class:list={[
        "min-w-0 px-4 py-10 sm:px-6 lg:px-0 lg:py-14",
        hasNotes && "max-xl:pb-28", // que el botón flotante no tape el final de la lección
      ]}
    >
      <slot />
    </main>

    {hasNotes && <slot name="notes" />}
  </div>
</BaseLayout>
