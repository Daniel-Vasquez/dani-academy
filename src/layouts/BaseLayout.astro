---
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/jetbrains-mono";
import "@/styles/global.css";
import { createHash } from "node:crypto";
import { ClientRouter } from "astro:transitions";
import themeInit from "@/scripts/theme-init.js?raw";
// Mismos archivos que usan los @font-face de Fontsource (subconjunto latin): se precargan
// para que el texto no cambie de fuente después del primer pintado (CLS)
import serifFont from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import sansFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

const preloadFonts = [serifFont, sansFont];

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Plataforma personal de aprendizaje full-stack." } = Astro.props;
const fullTitle = title === "Dani Academy" ? title : `${title} · Dani Academy`;

// Astro no calcula el hash de los scripts is:inline: se registra aquí sobre el mismo texto
// que se incrusta, así nunca se desincronizan (Astro.csp solo existe en build con CSP activa)
Astro.csp?.insertScriptHash(`sha256-${createHash("sha256").update(themeInit).digest("base64")}`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <title>{fullTitle}</title>

    <!-- Tema antes del primer pintado: script en línea con su hash en la CSP -->
    <script is:inline set:html={themeInit} />
    <ClientRouter />
  </head>
  <body class="min-h-dvh bg-bg font-sans text-fg">
    <slot />
  </body>
</html>
