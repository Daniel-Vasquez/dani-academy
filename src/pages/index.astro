---
// Página temporal de verificación de tokens (Tanda 0). Se sustituye en la Tanda 1.
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "@fontsource-variable/jetbrains-mono";
import "@/styles/global.css";
import { Code } from "astro:components";

const swatches = [
  "bg-bg",
  "bg-surface",
  "bg-surface-2",
  "bg-accent",
  "bg-accent-strong",
  "bg-info",
  "bg-warning",
  "bg-danger",
  "bg-danger-strong",
];

const sample = `function sumar(a: number, b: number): number {
  return a + b;
}`;
---

<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Tokens · Dani Academy</title>
  </head>
  <body class="min-h-dvh bg-bg p-10 font-sans text-fg">
    <main class="mx-auto max-w-[68ch]">
      <h1 class="font-serif text-4xl font-semibold tracking-tight">Dani Academy</h1>
      <p class="mt-2 text-muted">Verificación de tokens, fuentes y temas (Tanda 0).</p>

      <ul class="mt-8 grid grid-cols-3 gap-4 sm:grid-cols-5">
        {swatches.map((c) => (
          <li class="text-center text-xs text-muted">
            <div class={`h-16 rounded-xl ring-1 ring-surface-2 ${c}`} />
            <span class="mt-1 block font-mono">{c.replace("bg-", "")}</span>
          </li>
        ))}
      </ul>

      <button
        id="toggle"
        type="button"
        class="mt-8 rounded-xl bg-accent-strong px-5 py-2.5 text-sm font-semibold text-accent-contrast hover:opacity-90"
      >
        Cambiar tema
      </button>

      <article class="prose prose-lg mt-10 font-serif">
        <h2>Texto de lectura</h2>
        <p>
          Este párrafo usa <strong>Source Serif 4</strong> con el estilo <code>prose</code> ligado a
          los tokens. Los <a href="#">enlaces</a> usan el acento fuerte.
        </p>
        <Code
          code={sample}
          lang="ts"
          themes={{ light: "github-light", dark: "github-dark" }}
          defaultColor={false}
        />
      </article>
    </main>

    <script>
      document.getElementById("toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
      });
    </script>
  </body>
</html>
