---
import AuthLayout from "@/layouts/AuthLayout.astro";
import RegisterForm from "@/components/auth/RegisterForm";
import { safeRedirect } from "@/lib/redirect";

const redirectTo = safeRedirect(Astro.url.searchParams.get("redirect"));
const loginHref = `/login${redirectTo !== "/" ? `?redirect=${encodeURIComponent(redirectTo)}` : ""}`;
---

<AuthLayout title="Crear cuenta">
  <h1 class="font-serif text-2xl font-semibold tracking-tight">Crear cuenta</h1>
  <p class="mt-2 mb-8 text-sm text-muted">Solo necesitas tu nombre, tu correo y una contraseña.</p>
  <RegisterForm client:load redirectTo={redirectTo} />
  <p class="mt-6 text-center text-sm text-muted">
    ¿Ya tienes cuenta?{" "}
    <a href={loginHref} class="font-medium text-accent-strong hover:underline">
      Inicia sesión
    </a>
  </p>
</AuthLayout>
