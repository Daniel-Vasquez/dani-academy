{
  "printWidth": 100,
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": "*.mdx",
      "options": {
        "embeddedLanguageFormatting": "off",
        "proseWrap": "preserve"
      }
    }
  ],
  "tailwindStylesheet": "./src/styles/global.css"
}
